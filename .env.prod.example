# Copiar a .env.prod y rellenar los valores
# NUNCA commitear .env.prod (ya está en .gitignore)

# --- Base de datos ---
# Postgres es supabase-db: la imagen de Supabase EXIGE base `postgres` y usuario `postgres`.
# POSTGRES_PASSWORD debe ser URL-safe (hex/alfanumérica). Generar: scripts/supabase/generar-secretos.sh
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Supabase self-hosted ---
# Agregar además las variables de .env.supabase.example (JWT/ANON/SERVICE/PG_META, SMTP, URLs, etc.):
#   bash scripts/supabase/generar-secretos.sh   (genera POSTGRES_PASSWORD y SUPABASE_* de una vez)

# --- Login con Microsoft ---
# Lo gestiona GoTrue (docker-compose.supabase.yml); el backend no lo usa.
AZURE_AD_ENABLED=false
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# --- MSSQL / MBA3 ---
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DB=

# Notificaciones (correo + Teams) vía event-proxy/n8n WF-INTRA-01; vacías = SMTP.
# Ver docs/notificaciones.md (requiere docker-compose.prod.n8n.yml si n8n está en el mismo Docker).
FRONTEND_URL=https://TU_DOMINIO_DE_LA_INTRANET
N8N_NOTIFICAR_URL=http://n8n_app:5678/webhook/intranet-notificar
# Mismo secreto que la credencial «Intranet — X-Intranet-Secret» de n8n (nunca en el repo)
N8N_NOTIFICAR_SECRETO=
