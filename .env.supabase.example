# Variables del stack Supabase self-hosted (docker-compose.supabase.yml).
# Agregar al .env del entorno (.env.dev / .env.staging / .env.prod).
# Generar secretos:  bash scripts/supabase/generar-secretos.sh
#
# POSTGRES_PASSWORD es la MISMA que usa el backend. Debe ser URL-safe (hex/alfanumérica).
# POSTGRES_DB del backend pasa a ser `postgres` (la imagen de Supabase lo exige).

POSTGRES_PASSWORD=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PG_META_CRYPTO_KEY=

# URL pública donde nginx expone /auth/v1 y /storage/v1 (sin slash final)
SUPABASE_PUBLIC_URL=https://staging.rayhsa.net
# URL del frontend (destino tras login) y redirects extra permitidos (separados por coma)
SUPABASE_SITE_URL=https://staging.rayhsa.net
SUPABASE_REDIRECT_URLS=https://staging.rayhsa.net/auth/callback

SUPABASE_JWT_EXPIRY=3600
SUPABASE_DISABLE_SIGNUP=true
# true = no exige confirmar correo (usuarios internos creados por admin)
SUPABASE_EMAIL_AUTOCONFIRM=true

# SMTP (Microsoft 365) para invitaciones y recuperación de contraseña
SMTP_ADMIN_EMAIL=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Intranet Rayhsa

# Login con Microsoft (Entra ID, single-tenant)
AZURE_AD_ENABLED=false
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Storage: tamaño máximo por archivo (bytes). Alinear con client_max_body_size de nginx y multer
STORAGE_FILE_SIZE_LIMIT=52428800
# Puerto loopback de Studio (perfil admin)
SUPABASE_STUDIO_PORT=54323

# Pool de conexiones del backend (opcionales; defaults seguros entre paréntesis)
# Máximo de conexiones del pool compartido por portal/RH/tickets/auditoría (10)
# PG_POOL_MAX=10
# Milisegundos que una conexión ociosa permanece abierta (30000)
# PG_POOL_IDLE_TIMEOUT_MS=30000
# Milisegundos máximos esperando una conexión libre; al vencer la petición falla con 500 (5000)
# PG_POOL_CONNECTION_TIMEOUT_MS=5000
# Postgres cierra la sesión que deja una transacción abierta sin actividad este tiempo (30000)
# PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000

# Proxies de confianza delante del backend (llaves de ingesta de asistencia: lista de IP permitidas).
# Vacío = ninguno: req.ip es la dirección del socket y X-Forwarded-For se ignora. Valores admitidos:
# un número de proxies (1..10) o IP/CIDR de los proxies separadas por coma. NO usar true/all/uniquelocal.
# Ver docs/asistencia/operacion-ingesta.md
# TRUST_PROXY=

# Puerta de ingesta dedicada de las marcas de asistencia (segundo puerto del backend, solo rutas de ingesta,
# sin trust proxy: req.ip = IP real de la interfaz). Ver docs/asistencia/operacion-ingesta.md
# INGESTA_PORT=4010                      # default 4010 en dev/staging/prod. OJO: vacío en el compose NO la desactiva (vuelve a 4010);
#                                        # sin compose (node app.js) vacío = sin puerta dedicada
# INGESTA_SOLO_PUERTO_DEDICADO=true      # true (default en staging/prod): el puerto principal responde 404 a la ingesta; false en dev
# INGESTA_BIND=127.0.0.1                 # IP del host donde se publica el puerto; en el servidor: <ip-interna> (no versionar la IP real).
#                                        # NUNCA 0.0.0.0 ni la IP pública: expondría el puerto en todas las interfaces
# INGESTA_LIMITE_FALLOS_IP_POR_MINUTO=30 # fallos de autenticación por IP y minuto antes de responder 429 sin consultar la BD

# Motor de análisis de asistencia (planificador en proceso; ver docs/asistencia/motor-analisis.md)
# ASISTENCIA_MOTOR_ACTIVO=false          # false en dev/tests; los compose de staging y prod lo ponen en true. Solo el valor "true" lo activa
# ASISTENCIA_MOTOR_INTERVALO_MIN=15      # minutos entre vueltas (1-1440)
# ASISTENCIA_MOTOR_TIEMPO_MAX_MIN=10     # tiempo máximo por vuelta; lo pendiente se retoma en la siguiente (1-120)
# ASISTENCIA_MOTOR_RETRASO_INICIAL_S=30  # espera antes de la primera vuelta tras arrancar el servidor (0-3600)
