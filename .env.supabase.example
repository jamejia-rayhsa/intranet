# Variables del stack Supabase self-hosted (docker-compose.supabase.yml).
# Agregar al .env del entorno (.env.dev / .env.staging / .env.prod).
# Generar secretos:  bash scripts/supabase/generar-secretos.sh
#
# POSTGRES_PASSWORD es la MISMA que usa el backend. Debe ser URL-safe (hex/alfanumérica).
# POSTGRES_DB del backend pasa a ser `postgres` (la imagen de Supabase lo exige).

POSTGRES_PASSWORD=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PG_META_CRYPTO_KEY=

# URL pública donde nginx expone /auth/v1 y /storage/v1 (sin slash final)
SUPABASE_PUBLIC_URL=https://staging.rayhsa.net
# URL del frontend (destino tras login) y redirects extra permitidos (separados por coma)
SUPABASE_SITE_URL=https://staging.rayhsa.net
SUPABASE_REDIRECT_URLS=https://staging.rayhsa.net/auth/callback

SUPABASE_JWT_EXPIRY=3600
SUPABASE_DISABLE_SIGNUP=true
# true = no exige confirmar correo (usuarios internos creados por admin)
SUPABASE_EMAIL_AUTOCONFIRM=true

# SMTP (Microsoft 365) para invitaciones y recuperación de contraseña
SMTP_ADMIN_EMAIL=
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Intranet Rayhsa

# Login con Microsoft (Entra ID, single-tenant)
AZURE_AD_ENABLED=false
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Storage: tamaño máximo por archivo (bytes). Alinear con client_max_body_size de nginx y multer
STORAGE_FILE_SIZE_LIMIT=52428800
# Puerto loopback de Studio (perfil admin)
SUPABASE_STUDIO_PORT=54323
