# Copiar a .env.staging y rellenar los valores
# NUNCA commitear .env.staging (ya está en .gitignore)

# --- SHA del commit a desplegar ---
# Obtener con: git log --oneline -10
# O desde GitHub: https://github.com/jamejia-rayhsa/intranet/commits/main
IMAGE_TAG=<sha-del-commit>

# --- Puerto local del servidor staging ---
STAGING_HTTP_PORT=8080

# --- Base de datos ---
# Postgres es supabase-db: la imagen de Supabase EXIGE base `postgres` y usuario `postgres`.
# POSTGRES_PASSWORD debe ser URL-safe (hex/alfanumérica). Generar: scripts/supabase/generar-secretos.sh
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=staging_password_aqui

# --- Supabase self-hosted ---
# Agregar además las variables de .env.supabase.example (JWT/ANON/SERVICE/PG_META, SMTP, URLs, etc.):
#   bash scripts/supabase/generar-secretos.sh   (genera POSTGRES_PASSWORD y SUPABASE_* de una vez)

# --- Login con Microsoft (opcional en staging) ---
# Lo gestiona GoTrue (docker-compose.supabase.yml); el backend no lo usa.
AZURE_AD_ENABLED=false
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# --- MSSQL / MBA3 (opcional en staging) ---
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DB=

# --- MBA3 lectura (Convenios de compra, Fase 2) ---
# API REST propia (JWT) para leer catálogos de MBA3 (cliente/vendedor/producto/existencias-ventas);
# DISTINTA del web service de escritura de arriba (wsAPIS/api_wr, usado solo por Solicitudes de
# Crédito). Usuario de servicio administrado por quien mantiene MBA3. Sin estas variables, el
# autocompletar de Convenios falla de forma controlada (advertencia, no bloquea el guardado).
MBA3_LECTURA_URL=https://mba3api.rayhsa.net
MBA3_LECTURA_USUARIO=
MBA3_LECTURA_PASSWORD=
# mba3api.rayhsa.net está detrás de Cloudflare Access (Zero Trust): sin el Service Token de abajo,
# TODA petición (login, refresh, catálogo) recibe 403 o un 302 a la pantalla de login SSO de
# Cloudflare, sin llegar al código de MBA3. Pedir este Service Token a quien administra Cloudflare
# Access para rayhsa.net (puede ser otro equipo distinto al que administra MBA3). Las 2 variables
# van juntas: si falta cualquiera, no se manda ninguna (ver blockers.md).
MBA3_LECTURA_CF_ACCESS_CLIENT_ID=
MBA3_LECTURA_CF_ACCESS_CLIENT_SECRET=

# Notificaciones (correo + Teams) vía event-proxy/n8n WF-INTRA-01; vacías = SMTP
FRONTEND_URL=
N8N_NOTIFICAR_URL=
N8N_NOTIFICAR_SECRETO=
