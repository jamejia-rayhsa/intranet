# Copiar a .env.staging y rellenar los valores
# NUNCA commitear .env.staging (ya está en .gitignore)

# --- SHA del commit a desplegar ---
# Obtener con: git log --oneline -10
# O desde GitHub: https://github.com/jamejia-rayhsa/intranet/commits/main
IMAGE_TAG=<sha-del-commit>

# --- Puerto local del servidor staging ---
STAGING_HTTP_PORT=8080

# --- Base de datos ---
# Postgres es supabase-db: la imagen de Supabase EXIGE base `postgres` y usuario `postgres`.
# POSTGRES_PASSWORD debe ser URL-safe (hex/alfanumérica). Generar: scripts/supabase/generar-secretos.sh
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=staging_password_aqui

# --- Supabase self-hosted ---
# Agregar además las variables de .env.supabase.example (JWT/ANON/SERVICE/PG_META, SMTP, URLs, etc.):
#   bash scripts/supabase/generar-secretos.sh   (genera POSTGRES_PASSWORD y SUPABASE_* de una vez)

# --- Login con Microsoft (opcional en staging) ---
# Lo gestiona GoTrue (docker-compose.supabase.yml); el backend no lo usa.
AZURE_AD_ENABLED=false
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# --- MSSQL / MBA3 (opcional en staging) ---
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DB=
