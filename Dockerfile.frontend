# ============================================
# Etapa de desarrollo
# ============================================
FROM node:24-alpine AS development

WORKDIR /app

COPY package.json package-lock.json* ./
COPY modules/portal/backend/package.json ./modules/portal/backend/package.json
COPY modules/portal/frontend/package.json ./modules/portal/frontend/package.json
COPY modules/auditoria/backend/package.json ./modules/auditoria/backend/package.json
COPY modules/rh/backend/package.json ./modules/rh/backend/package.json
COPY modules/tickets/backend/package.json ./modules/tickets/backend/package.json

RUN npm install

COPY modules/ ./modules/
COPY config/ ./config/

EXPOSE 5173

CMD ["npm", "run", "dev:frontend"]

# ============================================
# Etapa de build (intermedia)
# ============================================
FROM node:24-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* ./
COPY modules/portal/backend/package.json ./modules/portal/backend/package.json
COPY modules/portal/frontend/package.json ./modules/portal/frontend/package.json
COPY modules/auditoria/backend/package.json ./modules/auditoria/backend/package.json
COPY modules/rh/backend/package.json ./modules/rh/backend/package.json
COPY modules/tickets/backend/package.json ./modules/tickets/backend/package.json

RUN npm ci

COPY modules/ ./modules/
COPY config/ ./config/

ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}
RUN npm run build:frontend

# ============================================
# Etapa de producción — nginx sirve el dist/
# ============================================
FROM nginx:alpine AS production

COPY --from=builder /app/modules/portal/frontend/dist /usr/share/nginx/html
COPY config/nginx/nginx.spa.conf /etc/nginx/conf.d/default.conf
# Genera /config.js (anon key, URL, flag de Microsoft) al ARRANCAR: una imagen para todos los entornos
COPY config/nginx/40-config-js.sh /docker-entrypoint.d/40-config-js.sh
RUN chmod +x /docker-entrypoint.d/40-config-js.sh

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
