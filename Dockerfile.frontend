# ============================================
# Etapa de desarrollo
# ============================================
FROM node:20-alpine AS development

WORKDIR /app

# Copiar package.json root y de todos los workspaces
COPY package.json package-lock.json* ./
COPY modules/portal/backend/package.json ./modules/portal/backend/package.json
COPY modules/portal/frontend/package.json ./modules/portal/frontend/package.json
COPY modules/auditoria/backend/package.json ./modules/auditoria/backend/package.json
COPY modules/rh/backend/package.json ./modules/rh/backend/package.json
COPY modules/tickets/backend/package.json ./modules/tickets/backend/package.json

# Instalar dependencias root y workspaces
RUN npm install

COPY modules/ ./modules/
COPY config/ ./config/

EXPOSE 5173

CMD ["npm", "run", "dev:frontend"]

# ============================================
# Etapa de producción
# ============================================
FROM node:20-alpine AS production

WORKDIR /app

# Copiar package.json root y de todos los workspaces
COPY package.json package-lock.json* ./
COPY modules/portal/backend/package.json ./modules/portal/backend/package.json
COPY modules/portal/frontend/package.json ./modules/portal/frontend/package.json
COPY modules/auditoria/backend/package.json ./modules/auditoria/backend/package.json
COPY modules/rh/backend/package.json ./modules/rh/backend/package.json
COPY modules/tickets/backend/package.json ./modules/tickets/backend/package.json

RUN npm ci

COPY modules/ ./modules/
COPY config/ ./config/

ARG VITE_API_URL=/api
ENV VITE_API_URL=${VITE_API_URL}

RUN npm run build:frontend

RUN npm prune --omit=dev

EXPOSE 5173

CMD ["npm", "run", "start:frontend"]
