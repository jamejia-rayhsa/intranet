{
  "root": true,
  "ignorePatterns": ["**/dist/**", "**/node_modules/**"],
  "env": {
    "es2022": true,
    "node": true
  },
  "extends": ["eslint:recommended"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.js", "**/*.spec.js"],
      "env": {
        "jest": true
      }
    },
    {
      "files": ["modules/*/frontend/**/*.{js,jsx}"],
      "env": {
        "browser": true,
        "node": false
      },
      "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module",
        "ecmaFeatures": {
          "jsx": true
        }
      },
      "plugins": ["react"],
      "rules": {
        "no-undef": "off",
        "react/jsx-uses-vars": "error"
      }
    }
  ]
}
